{
  "schemaVersion": 1,
  "id": "elytrautils",
  "version": "${version}",
  "name": "Elytra Utils",
  "description": "Optimise elytra experience",
  "authors": ["CC PCT"],
  "contact": {
    "repo": "https://github.com/CCPCT/ElytraUtils"
  },
  "license": "GPL-3.0-or-later",
  "icon": "assets/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "CCPCT.ElytraUtils.client.ElytraUtilsClient",
      "CCPCT.ElytraUtils.util.PacketHandler"
    ],
    "modmenu": [
      "CCPCT.ElytraUtils.config.ModMenu"
    ]
  },
  "mixins": [
    "ElytraUtils.mixin.json"
  ],
  "depends": {
    "fabric-api": "*",
    "fabricloader": "*",
    "minecraft": "${minecraft_range}",
    "java": ">=25",
    "modmenu": "*",
    "cloth-config": "*"
  }
}
